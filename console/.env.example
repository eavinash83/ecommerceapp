PORT=3100

# Shared secret Grafana sends as "Authorization: Bearer <value>". Use a long random string.
WEBHOOK_SECRET=
# Password for the triage page (HTTP Basic, any username).
CONSOLE_PASSWORD=

# Grafana Cloud stack URL and a READ-ONLY (Viewer) service account token.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Used by the headless Claude agent.
ANTHROPIC_API_KEY=

# Optional: Postgres for durable reports (a table is created automatically).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional overrides
# LOKI_SELECTOR={service_name="checkout-service"}
# PROM_SELECTOR=job="checkout-service"
# PROM_DATASOURCE_UID=
# LOKI_DATASOURCE_UID=
# COOLDOWN_MS=180000
# CLAUDE_TIMEOUT_MS=300000
# CLAUDE_MAX_TURNS=25
# SHOP_DIR=../shop    (folder containing the shop's server/ code)
